{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning"
    }
  },
  "IisEtw": {
    "Enabled": true,
    "ProviderName": "Microsoft-Windows-IIS-Logging",
    "ProviderId": "7e8ad27f-b271-4ea2-a783-a47bde29143b",
    "SessionName": "iisidsd-iis-logging",
    "SubscriptionBufferSize": 1000,
    "IngestionBufferSize": 10000
  },
  "Detection": {
    "MinimumSuspiciousStatusCode": 400,
    "RequestPathLengthThreshold": 512,
    "NotFoundBurstThreshold": 3,
    "NotFoundBurstLookbackLimit": 250,
    "NotFoundBurstWindowSeconds": 60,
    "AuthenticationFailureThreshold": 5,
    "AuthenticationFailureWindowSeconds": 60,
    "AuthenticationFailureScoreWeight": 1,
    "StatusScoreWeight": 1,
    "LongPathScoreWeight": 2,
    "RepeatedNotFoundScoreWeight": 3,
    "UnusualMethodScoreWeight": 3,
    "PathFragmentScoreWeight": 5,
    "UnknownExtensionScoreWeight": 2,
    "ScannerUserAgentScoreWeight": 6,
    "RequestRateScoreWeight": 2,
    "PathScanScoreWeight": 2,
    "RateThreshold": 60,
    "RateWindowSeconds": 60,
    "PathScanUniquePathThreshold": 20,
    "PathScanWindowSeconds": 60,
    "MaximumTrackedClientHistories": 1024,
    "MaximumTrackedHistoryBuckets": 131072,
    "MaximumTrackedPathsPerHistory": 128,
    "MaximumTrackedPathsTotal": 65536,
    "MaximumTrackedPathLengthCharacters": 1024,
    "MaximumTrackedExtensionSites": 256,
    "MaximumExtensionsPerSite": 128,
    "MaximumEventLatenessSeconds": 2,
    "SuspiciousPathFragments": [
      "../",
      "..\\",
      "%2e",
      "%2f",
      "%5c",
      "%00",
      "%252e",
      "wp-admin",
      "wp-login.php",
      "phpmyadmin",
      "/.env",
      "/.git",
      "git/config",
      "/etc/passwd",
      "/etc/shadow",
      "/proc/self/environ",
      "cmd.exe",
      "powershell",
      "cmd=",
      "exec=",
      "<script",
      "union select",
      "sleep(",
      "benchmark(",
      "xp_cmdshell",
      "jndi:",
      "${jndi:",
      "actuator",
      "server-status",
      "manager/html",
      "cgi-bin",
      "eval-stdin.php",
      "vendor/phpunit",
      "solr/admin",
      "console/login",
      "aws/credentials"
    ],
    "ScannerUserAgents": [
      "sqlmap",
      "nikto",
      "nmap",
      "masscan",
      "burp",
      "acunetix",
      "nessus",
      "openvas",
      "owasp zap",
      "zaproxy",
      "dirbuster",
      "gobuster",
      "ffuf",
      "feroxbuster",
      "nuclei",
      "wpscan",
      "metasploit",
      "arachni",
      "w3af",
      "whatweb",
      "skipfish",
      "hydra"
    ]
  },
  "Tray": {
    "BrowserUrl": "http://127.0.0.1:5080/"
  },
  "DetectionModules": {
    "Modules": {
      "heuristic": {
        "Enabled": true,
        "Mode": "Contribute"
      }
    }
  },
  "Notifications": {
    "Enabled": false,
    "Provider": "None",
    "MinimumSeverity": "High",
    "MinimumRiskScore": 8,
    "QueueCapacity": 1000,
    "StoredIncidentLimit": 10000,
    "CooldownMinutes": 15,
    "MaximumAttempts": 5,
    "RetryDelaySeconds": 15,
    "MaximumRetryDelaySeconds": 300,
    "DeliveryTimeoutSeconds": 10,
    "RetentionDays": 30,
    "DashboardUrl": "http://127.0.0.1:5080/"
  },
  "Storage": {
    "DatabasePath": "data/iisidsd.sqlite3",
    "JournalMode": "WAL",
    "SynchronousMode": "FULL",
    "BusyTimeoutSeconds": 5,
    "EventRetentionLimit": 100000,
    "EventRetentionDays": 30,
    "FindingRetentionDays": 30
  },
  "IisAdmin": {
    "EnableDenyListChanges": false,
    "AllowList": [],
    "TemporaryBanMinutes": 0,
    "DryRun": true,
    "RequireMultipleIndicators": true
  },
  "Dashboard": {
    "RemoteAccessEnabled": false,
    "AllowedHosts": [
      "localhost",
      "127.0.0.1",
      "::1"
    ]
  },
  "TrustedProxies": {
    "Enabled": false,
    "ForwardLimit": 1,
    "TrustedProxyIps": []
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  },
  "Urls": "http://127.0.0.1:5080"

}
