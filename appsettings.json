{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "IisEtw": {
    "Enabled": true,
    "ProviderName": "Microsoft-Windows-IIS-Logging",
    "ProviderId": "7e8ad27f-b271-4ea2-a783-a47bde29143b",
    "SessionName": "iisidsd-iis-logging",
    "SubscriptionBufferSize": 1000,
    "IngestionBufferSize": 10000
  },
  "Detection": {
    "MinimumSuspiciousStatusCode": 400,
    "RequestPathLengthThreshold": 512,
    "NotFoundBurstThreshold": 3,
    "NotFoundBurstLookbackLimit": 250,
    "StatusScoreWeight": 1,
    "LongPathScoreWeight": 2,
    "RepeatedNotFoundScoreWeight": 3,
    "UnusualMethodScoreWeight": 3,
    "PathFragmentScoreWeight": 5,
    "UnknownExtensionScoreWeight": 2,
    "ScannerUserAgentScoreWeight": 6,
    "RequestRateScoreWeight": 2,
    "PathScanScoreWeight": 2,
    "RateThreshold": 60,
    "RateWindowSeconds": 60,
    "PathScanUniquePathThreshold": 20,
    "PathScanWindowSeconds": 60,
    "SuspiciousPathFragments": [
      "../",
      "..\\",
      "%2e",
      "%2f",
      "%5c",
      "%00",
      "%252e",
      "wp-admin",
      "wp-login.php",
      "phpmyadmin",
      "/.env",
      "/.git",
      "git/config",
      "/etc/passwd",
      "/etc/shadow",
      "/proc/self/environ",
      "cmd.exe",
      "powershell",
      "cmd=",
      "exec=",
      "<script",
      "union select",
      "sleep(",
      "benchmark(",
      "xp_cmdshell",
      "jndi:",
      "${jndi:",
      "actuator",
      "server-status",
      "manager/html",
      "cgi-bin",
      "eval-stdin.php",
      "vendor/phpunit",
      "solr/admin",
      "console/login",
      "aws/credentials"
    ],
    "ScannerUserAgents": [
      "sqlmap",
      "nikto",
      "nmap",
      "masscan",
      "burp",
      "acunetix",
      "nessus",
      "openvas",
      "owasp zap",
      "zaproxy",
      "dirbuster",
      "gobuster",
      "ffuf",
      "feroxbuster",
      "nuclei",
      "wpscan",
      "metasploit",
      "arachni",
      "w3af",
      "whatweb",
      "skipfish",
      "hydra"
    ]
  },
  "Tray": {
    "BrowserUrl": "http://127.0.0.1:5080/"
  },
  "Storage": {
    "DatabasePath": "data/iisidsd.sqlite3",
    "EventRetentionLimit": 100000,
    "EventRetentionDays": 30,
    "FindingRetentionDays": 30
  },
  "IisAdmin": {
    "EnableDenyListChanges": false,
    "AllowList": [],
    "TemporaryBanMinutes": 0,
    "DryRun": true,
    "RequireMultipleIndicators": true
  },
  "Dashboard": {
    "RemoteAccessEnabled": false
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  },
  "Urls": "http://127.0.0.1:5080"

}
