      "events": [
        { "id": "missing-agent", "timestamp": "2026-10-20T12:25:00Z", "path": "/backup/archive-old", "clientIp": "198.51.100.29", "statusCode": 200, "userAgent": "", "expectedSuspicious": true }
      ]
    },
    {
      "id": "legitimate-crawler",
      "class": "legitimate_crawler",
      "description": "A small crawl of public pages remains below path-scan thresholds.",
