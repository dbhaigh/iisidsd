      ]
    },
    {
      "id": "legitimate-api-client",
      "class": "api_client",
      "description": "Frequent requests vary only query strings, which are excluded from unique-path counts.",
      "events": [
        { "id": "api-client", "timestamp": "2026-10-20T12:28:00Z", "path": "/v1/items?cursor={index}", "clientIp": "192.0.2.42", "statusCode": 200, "userAgent": "ExampleSdk/2.0", "repeat": 40, "intervalMilliseconds": 1000, "expectedSuspicious": false }
      ]
    },
    {
      "id": "application-error-burst",
      "class": "application_generated_error_burst",
      "description": "A deployment causes repeated 500 responses on a health endpoint; server-side failure is benign ground truth for client abuse.",
      "events": [
        { "id": "app-error", "timestamp": "2026-10-20T12:29:00Z", "path": "/health", "clientIp": "192.0.2.43", "statusCode": 500, "userAgent": "ExampleMonitor/1.0", "repeat": 12, "intervalMilliseconds": 1000, "expectedSuspicious": false }
      ]
    },
    {
      "id": "ipv4-repeated-not-found",
      "class": "ipv4_repeated_404",
      "description": "Three 404s from one IPv4 textual representation reach the repeated-not-found threshold.",
      "events": [
        { "id": "ipv4-404", "timestamp": "2026-10-20T12:30:00Z", "path": "/missing-{index}", "clientIp": "203.0.113.50", "statusCode": 404, "repeat": 3, "intervalMilliseconds": 1000, "expectedSuspicious": true }
      ]
    },
    {
      "id": "ipv6-repeated-not-found",
      "class": "ipv6_repeated_404",
      "description": "Three 404s from one IPv6 textual representation reach the repeated-not-found threshold.",
      "events": [
